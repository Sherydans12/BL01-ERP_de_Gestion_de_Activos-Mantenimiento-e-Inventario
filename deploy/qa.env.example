# Copiar a Coolify → Environment Variables (recurso Docker Compose QA).
# NO commitear valores reales. Rama Git: develop | Compose: docker-compose.qa.yml

# --- Dominios públicos (HTTPS, sin barra final en SITE; API con /api al final) ---
FRONTEND_URL=https://qa.app.baselogic.cl
BACKEND_PUBLIC_URL=https://qa.api.baselogic.cl
QA_API_URL=https://qa.api.baselogic.cl/api
QA_SITE_URL=https://qa.app.baselogic.cl

# --- Postgres (OBLIGATORIO: servicio db + DATABASE_URL del backend) ---
# Si DB_PASSWORD queda vacío, Postgres no inicia y el backend reinicia en bucle (P1001).
DB_USER=erp_qa
DB_PASSWORD=GENERAR_PASSWORD_LARGO_AQUI
DB_NAME=erp_qa

# --- Auth (distinto de producción) ---
JWT_SECRET=GENERAR_OTRO_SECRET_LARGO_SOLO_QA
# TOTP_ENCRYPTION_KEY=opcional_min_16_chars

# --- Email (Resend; puede ser mismo API key, remitente distinto) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=alertas-qa@mail.baselogic.cl
RESEND_FROM_NAME=BaseLogic QA

# --- Web Push QA (generar par nuevo: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:qa-notificaciones@baselogic.cl

# --- Storage: local en volumen Docker (simple) o R2 con prefijo qa ---
STORAGE_DRIVER=local
ALLOW_LOCAL_STORAGE_PURGE=true
# STORAGE_DRIVER=r2
# R2_BUCKET=baselogic-app-storage
# R2_KEY_PREFIX=env/qa
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_PUBLIC_URL=
