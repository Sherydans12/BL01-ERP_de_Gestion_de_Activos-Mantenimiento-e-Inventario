{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "rimraf dist && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:sync": "prisma migrate deploy && prisma generate",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:domain": "jest inventory-stock.service.spec inventory-transfer.service.spec inventory-adjustment.service.spec inventory-items.service.spec warehouse-receipts.service.spec purchase-requisitions.service.spec tenant-role-defaults.spec purchase-settings.service.spec purchase-orders.service.spec purchase-invoices.service.spec purchase-credit-notes.service.spec signature.util.spec",
    "test:domain:watch": "jest --watch inventory-stock.service.spec inventory-transfer.service.spec inventory-adjustment.service.spec inventory-items.service.spec warehouse-receipts.service.spec purchase-requisitions.service.spec tenant-role-defaults.spec purchase-settings.service.spec purchase-orders.service.spec purchase-invoices.service.spec purchase-credit-notes.service.spec signature.util.spec",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "email-previews": "ts-node -r tsconfig-paths/register --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" src/common/email/preview-renderer.ts",
    "seed:p2p-test-users": "ts-node prisma/seed-p2p-test-users.ts",
    "seed:catalog-masters": "ts-node prisma/seed-catalog-masters.ts",
    "seed:super-admin": "node scripts/seed-super-admin.mjs",
    "seed:load-test-items": "ts-node prisma/seed-load-test-items.ts",
    "db:clean-test-data": "ts-node prisma/clean-test-data.ts",
    "db:clean-bootstrap-tpm": "ts-node prisma/clean-and-bootstrap-tpm-users.ts",
    "seed:inventory-masters": "ts-node prisma/seed-inventory-masters.ts",
    "db:import-inventory-excel": "ts-node prisma/import-inventory-from-excel.ts",
    "export:inventory-snapshot": "ts-node prisma/export-inventory-snapshot.ts",
    "benchmark:purchase-stress": "ts-node prisma/benchmark-purchase-stress.ts",
    "storage:migrate:r2": "[ -f dist/src/scripts/migrate-local-storage-to-r2.js ] && node dist/src/scripts/migrate-local-storage-to-r2.js || ts-node src/scripts/migrate-local-storage-to-r2.ts",
    "storage:verify:db": "[ -f dist/src/scripts/verify-storage-db-health.js ] && node dist/src/scripts/verify-storage-db-health.js || ts-node src/scripts/verify-storage-db-health.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1037.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "nodemailer": "^8.0.3",
    "otplib": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "playwright": "^1.52.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "jest-mock-extended": "^3.0.7",
    "prettier": "^3.4.2",
    "prisma": "^7.5.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/../test/jest-setup.ts"]
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
