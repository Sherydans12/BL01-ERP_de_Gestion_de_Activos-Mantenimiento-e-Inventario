# Base de Datos
DATABASE_URL="postgresql://erp_admin:supersecretpassword@db:5432/erp_database?schema=public"

# Servidor
PORT=3000

# Seguridad
JWT_SECRET="CAMBIAR_ESTO_EN_PRODUCCION"

# Frontend Link (CORS) - Debe coincidir exactamente con el origen del frontend
FRONTEND_URL="https://app.baselogic.cl"
# URL pública del backend (opcional pero recomendada para enlaces absolutos de archivos)
BACKEND_PUBLIC_URL="https://api.baselogic.cl"

# Web Push (VAPID) — Generar con: npx web-push generate-vapid-keys
# El front debe usar solo VAPID_PUBLIC_KEY para suscribirse.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contacto del remitente (RFC 8292), p. ej. mailto del equipo
VAPID_SUBJECT="mailto:notificaciones@baselogic.cl"

# Email Provider (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="alertas@mail.baselogic.cl"
RESEND_FROM_NAME="Sistema BaseLogic"

# Storage (local | r2)
STORAGE_DRIVER="local"
UPLOAD_PATH="./uploads"

# Cloudflare R2 (S3-compatible) - requerido cuando STORAGE_DRIVER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="baselogic-app-storage-prod"
R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_REGION="auto"
# Opcional: dominio público/CDN para servir objetos sin URL firmada.
R2_PUBLIC_URL=""
# Opcional: prefijo global dentro del bucket (ej: env/prod)
R2_KEY_PREFIX=""
