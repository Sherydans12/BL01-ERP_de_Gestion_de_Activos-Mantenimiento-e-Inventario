generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. MAESTRO DE FLOTA (EQUIPMENT)
// ==========================================
model Equipment {
  id                    String      @id @default(uuid()) @db.Uuid
  tenantId              String      @map("tenant_id") @db.Uuid
  contractId            String?     @map("contract_id") @db.Uuid // Asignación directa
  subcontractId         String?     @map("subcontract_id") @db.Uuid // Asignación indirecta
  mineInternalId        String?     @map("mine_internal_id") @db.VarChar(50)
  internalId            String      @map("internal_id") @db.VarChar(50)
  plate                 String?     @db.VarChar(20)
  type                  String      @db.VarChar(50)
  brand                 String      @db.VarChar(50)
  model                 String      @db.VarChar(50)
  
  // Lógica de Medición (Evolucionado)
  meterType             MeterType   @default(HOURS) @map("meter_type")
  initialMeter          Int         @default(0) @map("initial_meter")
  currentMeter          Int         @default(0) @map("current_meter")
  
  // Identificación Extendida
  vin                   String?     @db.VarChar(50)
  engineNumber          String?     @map("engine_number") @db.VarChar(50)
  serialNumber          String?     @map("serial_number") @db.VarChar(80)
  year                  Int?

  // Operación y Mantenimiento (Evolucionado)
  fuelType              String?     @map("fuel_type") @db.VarChar(50)
  driveType             String?     @map("drive_type") @db.VarChar(50)
  /** Nombre del ítem de catálogo OWNERSHIP (Tipo de Propiedad). */
  ownership             String?     @db.VarChar(50)
  isSubleased           Boolean     @default(false) @map("is_subleased")
  /** Empresa a la que se arrienda el activo (obligatorio si isSubleased). */
  subleaseCompanyName   String?     @map("sublease_company_name") @db.VarChar(200)
  maintenanceFrequency  Int?        @map("maintenance_frequency")
  /** Intervalo PM en horas o km según meterType (250, 500, 600, 10000…). Si null, usa reglas por tipo en cliente. */
  pmIntervalOverride    Int?        @map("pm_interval_override")
  lastMaintenanceDate   DateTime?   @map("last_maintenance_date") @db.Date
  lastMaintenanceMeter  Int?        @map("last_maintenance_meter")
  lastMaintenanceType   String?     @map("last_maintenance_type") @db.VarChar(100)
  
  // Vencimientos Legales (Evolucionado)
  techReviewExp         DateTime?   @map("tech_review_exp") @db.Date
  circPermitExp         DateTime?   @map("circ_permit_exp") @db.Date
  soapExp               DateTime?   @map("soap_exp") @db.Date
  mechanicalCertExp     DateTime?   @map("mechanical_cert_exp") @db.Date
  liabilityPolicyExp    DateTime?   @map("liability_policy_exp") @db.Date

  /** False cuando hay OT abierta/en curso que declara fuera de servicio al equipo. */
  isOperational         Boolean     @default(true) @map("is_operational")
  /** Horas acumuladas de indisponibilidad atribuibles a OT (detención con impacto disponibilidad). */
  cumulativeDowntimeHours Decimal @default(0) @map("cumulative_downtime_hours") @db.Decimal(14, 4)

  // Auditoría
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relaciones
  tenant                Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract              Contract?    @relation(fields: [contractId], references: [id], onDelete: Restrict)
  subcontract           Subcontract? @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  workOrders            WorkOrder[]
  meterAdjustments      MeterAdjustment[]
  meterLogs             EquipmentMeterLog[]
  purchaseRequisitions  PurchaseRequisition[] @relation("RequisitionEquipment")
  purchaseOrders        PurchaseOrder[]       @relation("OrderEquipment")
  assetCostRecords      AssetCostRecord[]

  @@unique([tenantId, internalId])
  @@unique([tenantId, plate])
  @@unique([tenantId, vin])
  @@map("equipments")
}

// ==========================================
// 2. CATÁLOGOS GLOBALES (SYSTEMS, FLUIDS)
// ==========================================
model CatalogItem {
  id                  String            @id @default(uuid()) @db.Uuid
  tenantId            String            @map("tenant_id") @db.Uuid
  code                String            @db.VarChar(20) // Ej: SYS-01, FLD-01
  name                String            @db.VarChar(100)
  category            CatalogCategory
  isActive            Boolean           @default(true) @map("is_active")

  // Relaciones
  tenant              Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  systemInterventions WorkOrderSystem[]
  fluidConsumptions   WorkOrderFluid[]
  fluidSamples        FluidSample[]     // NUEVA RELACIÓN: Muestras APD por sistema

  @@unique([tenantId, code])
  @@map("catalog_items")
}

enum CatalogCategory {
  EQUIPMENT_TYPE
  BRAND
  SYSTEM
  FLUID
  FUEL_TYPE
  DRIVE_TYPE
  OWNERSHIP
}

// ==========================================
// 3. ÓRDENES DE TRABAJO (OT)
// ==========================================
model WorkOrder {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  /** Usuario que registró la OT (auditoría). */
  createdByUserId   String?           @map("created_by_user_id") @db.Uuid
  subcontractId     String?           @map("subcontract_id") @db.Uuid
  warehouseId       String?           @map("warehouse_id") @db.Uuid // Bodega de consumo (Integración Fase C)
  correlative       String            @db.VarChar(30)
  equipmentId       String            @map("equipment_id") @db.Uuid
  type              OtType            @default(NUEVA)
  category          OtCategory
  maintenanceType   MaintenanceType   @map("maintenance_type")
  status            OtStatus          @default(OPEN)
  responsible       String?           @db.VarChar(100)
  
  initialMeter      Int               @map("initial_meter")
  /** Opcional hasta que supervisor complete horómetro al cierre o edición. */
  finalMeter        Int?              @map("final_meter")
  description       String            @db.Text
  
  hasBacklog        Boolean           @default(false) @map("has_backlog")

  detentionStartedAt     DateTime?  @map("detention_started_at")
  detentionEndedAt       DateTime?  @map("detention_ended_at")
  detentionInitialMeter  Int?       @map("detention_initial_meter")
  detentionFinalMeter    Int?       @map("detention_final_meter")

  /** Ventana de atención mecánica (datetime local → UTC). */
  mechanicAttentionStartedAt DateTime? @map("mechanic_attention_started_at")
  mechanicAttentionEndedAt   DateTime? @map("mechanic_attention_ended_at")

  /** Cantidad de técnicos (HH = HM × personnelQuantity al cierre). */
  personnelQuantity Int @default(1) @map("personnel_quantity")

  clientAttributedStart  DateTime?  @map("client_attributed_start")
  clientAttributedEnd    DateTime?  @map("client_attributed_end")
  clientAttributedReason String?    @map("client_attributed_reason") @db.Text

  affectsAvailability  AvailabilityImpact?  @map("affects_availability")
  /** Tags multi-selección: PROGRAMADA, NO_PROGRAMADA, ACCIDENTE_INCIDENTE, OT_ABIERTA_CONTINUIDAD, OT_ABIERTA_GEN_BCK, POSIBLE_GARANTIA */
  classificationTags   String[]   @default([]) @map("classification_tags")

  workLocation  EquipmentWorkLocation? @map("work_location")
  metricHm      Decimal?  @map("metric_hm") @db.Decimal(14, 4)
  metricHh      Decimal?  @map("metric_hh") @db.Decimal(14, 4)
  workShift     WorkShift? @map("work_shift")

  initialRequestDescription String? @map("initial_request_description") @db.Text
  intervenedSystemsJson      Json?  @map("intervened_systems_json")
  symptomsText               String? @map("symptoms_text") @db.Text
  causeText                  String? @map("cause_text") @db.Text
  workPerformedDescription    String? @map("work_performed_description") @db.Text

  techniciansNames               String? @map("technicians_names") @db.Text
  /** IDs de usuarios (mecánicos) asociados como participantes. */
  participantUserIds             String[] @default([]) @map("participant_user_ids")
  /** Usuario supervisor elegido para validación de turno. */
  shiftSupervisorUserId          String? @map("shift_supervisor_user_id") @db.Uuid
  responsibleMechanicName        String? @map("responsible_mechanic_name") @db.VarChar(150)
  responsibleMechanicSignature    String? @map("responsible_mechanic_signature") @db.VarChar(255)
  shiftSupervisorName             String? @map("shift_supervisor_name") @db.VarChar(150)
  shiftSupervisorSignature       String? @map("shift_supervisor_signature") @db.VarChar(255)

  /** Ciclo PM 1–4 cuando aplica */
  pmCycleNumber Int? @map("pm_cycle_number")

  /** Primer paso a EN_CURSO (auditoría). */
  inProgressAt      DateTime?         @map("in_progress_at")
  /** Respuesta al cierre: equipo quedó operativo sí/no. */
  closureEquipmentOperational Boolean? @map("closure_equipment_operational")

  // Auditoría
  createdAt         DateTime          @default(now()) @map("created_at")
  syncedAt          DateTime?         @map("synced_at")
  closedAt          DateTime?         @map("closed_at")

  // Relaciones
  tenant            Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser     User?             @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  shiftSupervisorUser User?           @relation("WorkOrderShiftSupervisor", fields: [shiftSupervisorUserId], references: [id], onDelete: SetNull)
  subcontract       Subcontract?      @relation(fields: [subcontractId], references: [id], onDelete: SetNull)
  equipment         Equipment         @relation(fields: [equipmentId], references: [id])
  warehouse         Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  systems           WorkOrderSystem[]
  fluids            WorkOrderFluid[]
  tasks             WorkOrderTask[]
  parts             WorkOrderPart[]
  fluidSamples      FluidSample[]
  stockReservations    StockReservation[]
  purchaseRequisitions PurchaseRequisition[] @relation("RequisitionWorkOrder")
  purchaseOrders       PurchaseOrder[]       @relation("OrderWorkOrder")
  assetCostRecords     AssetCostRecord[]
  backlogItems         WorkOrderBacklogItem[]
  fluidCompartments    WorkOrderFluidCompartment[]

  @@unique([tenantId, correlative])
  @@map("work_orders")
}

model WorkOrderBacklogItem {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  workOrderId  String        @map("work_order_id") @db.Uuid
  description  String        @db.Text
  status       BacklogStatus @default(PENDING)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("work_order_backlog_items")
}

model WorkOrderFluidCompartment {
  id              String           @id @default(uuid()) @db.Uuid
  workOrderId     String           @map("work_order_id") @db.Uuid
  compartment     FluidCompartment
  fluidType       String           @map("fluid_type") @db.VarChar(200)
  liters          Decimal          @db.Decimal(14, 4)
  action          FluidAction
  inventoryItemId String?          @map("inventory_item_id") @db.Uuid

  workOrder      WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@map("work_order_fluid_compartments")
}

enum OtType {
  NUEVA
  CONTINUIDAD
}

enum OtCategory {
  PROGRAMADA
  NO_PROGRAMADA_CORRECTIVA
  NO_PROGRAMADA_REACTIVA
  NO_PROGRAMADA_PREVENTIVO
}

enum MeterType {
  HOURS
  KILOMETERS
}

enum MaintenanceType {
  PREVENTIVO
  CORRECTIVO
}

enum OtStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  CLOSED
}

enum AvailabilityImpact {
  SI
  NO
  STP
}

enum EquipmentWorkLocation {
  TALLER
  TERRENO
}

enum WorkShift {
  DIA
  NOCHE
}

enum FluidCompartment {
  MOTOR
  TRANSMISION
  DIRECCION
  HIDRAULICO
  MANDOS
  DIFERENCIAL
  REFRIGERANTE
  OTROS
}

enum BacklogStatus {
  PENDING
  DONE
}

// ==========================================
// 4. TABLAS INTERMEDIAS Y COMPONENTES DE OT
// ==========================================
model WorkOrderSystem {
  workOrderId   String      @map("work_order_id") @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid

  workOrder     WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@id([workOrderId, catalogItemId])
  @@map("work_order_systems")
}

model WorkOrderFluid {
  id            String      @id @default(uuid()) @db.Uuid
  workOrderId   String      @map("work_order_id") @db.Uuid
  catalogItemId String      @map("catalog_item_id") @db.Uuid
  
  liters        Float
  action        FluidAction

  workOrder     WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@map("work_order_fluids")
}

enum FluidAction {
  RELLENO
  CAMBIO
}

// --- EXTENSIÓN TPM: TAREAS, REPUESTOS Y MUESTRAS ---

model WorkOrderTask {
  id              String      @id @default(uuid()) @db.Uuid
  workOrderId     String      @map("work_order_id") @db.Uuid
  description     String      @db.VarChar(255)
  action          TaskAction? @default(INSPECT)
  estimatedHours  Float?      @map("estimated_hours")
  isCompleted     Boolean     @default(false) @map("is_completed")
  observation     String?     @db.Text
  measurement     Float?    
  trackingCode    String?     @map("tracking_code") @db.VarChar(50)
  
  workOrder       WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  
  @@map("work_order_tasks")
}

enum TaskAction {
  INSPECT
  REPLACE
  ADJUST
  CLEAN
  LUBRICATE
}

model WorkOrderPart {
  id              String         @id @default(uuid()) @db.Uuid
  workOrderId     String         @map("work_order_id") @db.Uuid
  
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid 
  
  partNumber      String         @map("part_number") @db.VarChar(50)
  description     String         @db.VarChar(100)
  quantity        Float          @default(1)

  unitCost        Float?         @map("unit_cost")
  
  workOrder       WorkOrder      @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  
  @@map("work_order_parts")
}

model FluidSample {
  id              String       @id @default(uuid()) @db.Uuid
  workOrderId     String       @map("work_order_id") @db.Uuid
  systemId        String       @map("system_id") @db.Uuid // Motor, Transmisión, etc.
  bottleCode      String       @map("bottle_code") @db.VarChar(50) // Código del frasco APD
  status          SampleStatus @default(PENDING)
  results         String?      @db.Text
  
  workOrder       WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  system          CatalogItem  @relation(fields: [systemId], references: [id], onDelete: Restrict)

  @@map("fluid_samples")
}

enum SampleStatus {
  PENDING
  SENT_TO_LAB
  ANALYZED
}

// ==========================================
// 5. MANTENIMIENTO: KITS PREDEFINIDOS (PM)
// ==========================================

model MaintenanceKit {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  contractId      String                 @map("contract_id") @db.Uuid
  subcontractId   String?                @map("subcontract_id") @db.Uuid
  code            String                 @db.VarChar(50) 
  name            String                 @db.VarChar(100)
  description     String?                @db.Text
  
  equipmentBrand  String?                @map("equipment_brand") @db.VarChar(50)
  equipmentModel  String?                @map("equipment_model") @db.VarChar(50)
  
parts           MaintenanceKitPart[]
  
  contract        Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  subcontract     Subcontract?           @relation(fields: [subcontractId], references: [id], onDelete: Cascade) // NUEVA RELACIÓN

  @@unique([tenantId, code])
  @@map("maintenance_kits")
}

model MaintenanceKitPart {
  id              String         @id @default(uuid()) @db.Uuid
  kitId           String         @map("kit_id") @db.Uuid
  partNumber      String         @map("part_number") @db.VarChar(50)
  description     String         @db.VarChar(100)
  quantity        Float          @default(1)

  kit             MaintenanceKit @relation(fields: [kitId], references: [id], onDelete: Cascade)

  @@map("maintenance_kit_parts")
}

// ==========================================
// 6. USUARIOS Y AUTENTICACIÓN
// ==========================================

enum AuthAuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  PASSWORD_CHANGE
  LOGOUT
}

/// Auditoría de accesos (login, cambio de clave, logout) con contexto de red/geo.
model AuthAuditLog {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  emailAttempted String          @map("email_attempted") @db.VarChar(100)
  action         AuthAuditAction
  ipAddress      String          @map("ip_address") @db.VarChar(64)
  userAgent      String          @map("user_agent") @db.VarChar(512)
  city           String          @default("") @db.VarChar(120)
  country        String          @default("") @db.VarChar(120)
  isSuspicious   Boolean         @default(false) @map("is_suspicious")
  createdAt      DateTime        @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([emailAttempted, createdAt])
  @@map("auth_audit_logs")
}

/// Sesión de acceso (JWT `jti`) para revocación y control de dispositivos.
model UserSession {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  jti          String   @unique @db.VarChar(64)
  deviceLabel  String   @map("device_label") @db.VarChar(200)
  ipAddress    String   @map("ip_address") @db.VarChar(64)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  isValid      Boolean  @default(true) @map("is_valid")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isValid])
  @@map("user_sessions")
}

/// Configuración de seguridad a nivel plataforma (una fila).
model PlatformSecuritySettings {
  id                           String   @id @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  superAdminStepUpEmailEnabled Boolean  @default(false) @map("super_admin_step_up_email_enabled")
  updatedAt                    DateTime @updatedAt @map("updated_at")

  @@map("platform_security_settings")
}

/// Desafío de segundo factor por correo (login SUPER_ADMIN) antes de emitir JWT.
model LoginStepUpChallenge {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  codeHash  String    @map("code_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  clientIp  String    @map("client_ip") @db.VarChar(64)
  userAgent String    @map("user_agent") @db.VarChar(512)
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([tokenHash])
  @@map("login_step_up_challenges")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  email               String          @unique @db.VarChar(100)
  password            String          @db.VarChar(255)
  name                String          @db.VarChar(100)
  /// Nombre de pila (perfil). Si null, la UI puede derivar de `name`.
  firstName           String?         @map("first_name") @db.VarChar(100)
  /// Apellido(s) (perfil). Si null, la UI puede derivar de `name`.
  lastName            String?         @map("last_name") @db.VarChar(100)
  /// Ruta pública servida bajo `/uploads/...` (StorageService local).
  avatarUrl           String?         @map("avatar_url") @db.VarChar(500)
  role                UserRole        @default(MECHANIC)
  isActive            Boolean         @default(false) @map("is_active")
  activationToken     String?         @map("activation_token") @db.VarChar(255)
  resetPasswordToken  String?         @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires DateTime?      @map("reset_password_expires")
  /// Hasta cuándo no se permite login (fuerza bruta).
  lockoutUntil        DateTime?       @map("lockout_until")
  /// Si true, envía correo cuando el login exitoso difiere en IP o país respecto al anterior.
  notifyUnusualLogin  Boolean         @default(true) @map("notify_unusual_login")

  /// Segundo factor TOTP (Google Authenticator, etc.); hoy soportado en flujo Super Admin.
  totpEnabled           Boolean         @default(false) @map("totp_enabled")
  /// 2FA por correo electrónico habilitado por el propio usuario o forzado por la empresa.
  email2faEnabled       Boolean         @default(false) @map("email_2fa_enabled")
  /// Secreto TOTP cifrado en reposo (AES-256-GCM + base64).
  totpSecretEncrypted   String?         @map("totp_secret_encrypted") @db.Text

  rut                 String?         @db.VarChar(20)
  phone               String?         @db.VarChar(20)
  birthDate           DateTime?       @map("birth_date") @db.Date
  position            String?         @db.VarChar(100)
  
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  tenantId            String?         @map("tenant_id") @db.Uuid
  customRoleId        String?         @map("custom_role_id") @db.Uuid

  tenant              Tenant?         @relation(fields: [tenantId], references: [id])
  customRole          TenantRole?     @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  contractAccess      UserContract[]  
  inventoryTransactions InventoryTransaction[]
  meterAdjustments    MeterAdjustment[]
  equipmentMeterLogs  EquipmentMeterLog[]
  inventoryItemAttachments InventoryItemAttachment[]

  purchaseRequisitions    PurchaseRequisition[]      @relation("RequisitionRequester")
  purchaseOrderApprovals  PurchaseOrderApproval[]    @relation("POApprover")
  approvalPolicyUsers     ApprovalPolicyUser[]       @relation("ApprovalPolicyUsers")
  warehouseReceipts       WarehouseReceipt[]         @relation("ReceiptReceiver")
  activityLogs            ActivityLog[]
  pushSubscriptions       PushSubscription[]
  inventoryTransfersCreated InventoryTransfer[] @relation("InventoryTransferCreatedBy")
  purchaseDocumentsUploaded PurchaseDocument[]
  authAuditLogs            AuthAuditLog[]
  loginStepUpChallenges     LoginStepUpChallenge[]
  sessions                 UserSession[]
  workOrdersCreated        WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrdersSupervised     WorkOrder[]           @relation("WorkOrderShiftSupervisor")

  @@unique([tenantId, rut])
  @@map("users")
}

model Tenant {
  id                    String                @id @default(uuid()) @db.Uuid
  code                  String                @unique @db.VarChar(20)
  name                  String                @db.VarChar(100)
  
  rut                   String?               @db.VarChar(20)
  address               String?               @db.VarChar(255)
  phone                 String?               @db.VarChar(20)

  logoUrl               String?               @map("logo_url") @db.VarChar(255)
  primaryColor          String                @default("#FF3366") @map("primary_color") @db.VarChar(50)
  laborRatePerHour      Decimal?              @default(0) @map("labor_rate_per_hour") @db.Decimal(12, 2)
  backgroundPreference  BackgroundPreference  @default(DARK) @map("background_preference")
  sidebarPermissions    Json?                 @map("sidebar_permissions")

  isActive              Boolean               @default(true) @map("is_active")
  
  contracts             Contract[]    
  users                 User[]
  equipments            Equipment[]
  equipmentMeterLogs    EquipmentMeterLog[]
  workOrders            WorkOrder[]
  workOrderBacklogItems WorkOrderBacklogItem[]
  catalogs              CatalogItem[]
  warehouses            Warehouse[]
  inventoryItems        InventoryItem[]
  inventorySuppliers    InventorySupplier[]
  itemCategories        ItemCategory[]
  unitOfMeasures       UnitOfMeasure[]
  tenantRoles           TenantRole[]

  vendors               Vendor[]
  purchaseSettings      PurchaseSettings?
  purchaseRequisitions  PurchaseRequisition[]
  purchaseQuotations    PurchaseQuotation[]
  purchaseOrders        PurchaseOrder[]
  warehouseReceipts     WarehouseReceipt[]
  purchaseInvoices      PurchaseInvoice[]
  assetCostRecords      AssetCostRecord[]
  sequenceCounters      SequenceCounter[]
  activityLogs          ActivityLog[]
  pushSubscriptions     PushSubscription[]
  inventoryItemAttachments InventoryItemAttachment[]
  inventoryTransfers    InventoryTransfer[]
  purchaseDocuments     PurchaseDocument[]

  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("tenants")
}

model TenantRole {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  baseRole    UserRole @default(MECHANIC) @map("base_role")
  routes      Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users              User[]

  @@unique([tenantId, name])
  @@map("tenant_roles")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  MECHANIC
}

enum BackgroundPreference {
  DARK
  LIGHT
}

// ==========================================
// 7. CONTRATOS Y SUBCONTRATOS
// ==========================================
model Contract {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  code          String          @db.VarChar(50)
  name          String          @db.VarChar(100)
  isActive      Boolean         @default(true) @map("is_active")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subcontracts  Subcontract[]
  users         UserContract[]
  equipments    Equipment[]
  maintenanceKits MaintenanceKit[]
  warehouses      Warehouse[]

  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("contracts")
}

model Subcontract {
  id            String          @id @default(uuid()) @db.Uuid
  contractId    String          @map("contract_id") @db.Uuid
  code          String          @db.VarChar(50)
  name          String          @db.VarChar(100)
  isActive      Boolean         @default(true) @map("is_active")

  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  equipments    Equipment[]
  workOrders    WorkOrder[]
  maintenanceKits MaintenanceKit[]
  warehouses      Warehouse[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]

  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([contractId, code])
  @@map("subcontracts")
}

model UserContract {
  userId        String          @map("user_id") @db.Uuid
  contractId    String          @map("contract_id") @db.Uuid

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@id([userId, contractId])
  @@map("user_contracts")
}

// ==========================================
// 8. MÓDULO DE INVENTARIO Y BODEGA (FASE C)
// ==========================================

/// Proveedor habitual asociado a artículos de inventario (catálogo por tenant).
/// Independiente del módulo de compras (PurchaseOrder / Quotation).
model InventorySupplier {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String  @db.VarChar(150)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("inventory_suppliers")
}

model ItemCategory {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  name             String         @db.VarChar(100)
  description      String?        @db.Text
  /// Nivel 1 (familia): null. Nivel 2 (subcategoría): referencia a la familia.
  parentCategoryId String?        @map("parent_category_id") @db.Uuid
  /// true = familia de nivel 1 (sin padre). Los artículos solo se vinculan a subcategorías (hojas).
  isGlobal         Boolean        @default(false) @map("is_global")

  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentCategory   ItemCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  childCategories  ItemCategory[] @relation("CategoryHierarchy")
  items            InventoryItem[]

  @@index([tenantId])
  @@index([tenantId, parentCategoryId])
  @@map("item_categories")
}

/// Unidades de medida configurables por tenant (maestro).
model UnitOfMeasure {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  name           String   @db.VarChar(100)
  abbreviation   String   @db.VarChar(20)
  /// Si true, permite cantidades fraccionarias (ej. KG, LT, MT). Si false, solo enteros (ej. UN).
  allowsDecimals Boolean  @default(false) @map("allows_decimals")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@unique([tenantId, abbreviation])
  @@index([tenantId])
  @@map("unit_of_measures")
}

model WarehouseBin {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @map("warehouse_id") @db.Uuid
  code        String    @db.VarChar(50)
  label       String?   @db.VarChar(100)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stocks      ItemStock[]

  @@unique([warehouseId, code])
  @@map("warehouse_bins")
}

model Warehouse {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  contractId      String       @map("contract_id") @db.Uuid 
  subcontractId   String?      @map("subcontract_id") @db.Uuid // NUEVO: Bodega asignable a Subcontrato

  code            String        @db.VarChar(50)
  name            String        @db.VarChar(100)
  location        String?       @db.VarChar(255)
  type            WarehouseType @default(PHYSICAL)
  isActive        Boolean       @default(true) @map("is_active")

  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract        Contract     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  subcontract     Subcontract? @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  
  bins              WarehouseBin[]
  stocks            ItemStock[]
  transactions      InventoryTransaction[]
  workOrders        WorkOrder[]
  stockReservations StockReservation[]
  warehouseReceipts WarehouseReceipt[]
  outboundTransfers  InventoryTransfer[] @relation("InventoryTransferOrigin")
  inboundTransfers   InventoryTransfer[] @relation("InventoryTransferDestination")
  inventoryItemsAsPolicyTarget InventoryItem[] @relation("InventoryItemPolicyTargetWarehouse")

  @@unique([tenantId, code])
  @@map("warehouses")
}

model InventoryItem {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid

  /// SKU interno ERP (alta vía API: siempre autogenerado IN####; importación/script puede fijar valor; no editable por PUT).
  inventoryCode   String?       @map("inventory_code") @db.VarChar(60)

  /// Payload estable para QR / pistola (típicamente INV:<uuid>).
  qrCode          String        @map("qr_code") @db.VarChar(120)
  /// Número de parte (opcional; obligatorio para repuestos, innecesario en insumos sin referencia).
  partNumber      String?       @map("part_number") @db.VarChar(50)
  name            String        @db.VarChar(150)
  description     String?       @db.Text
  /// Subcategoría (nivel 2); la familia se obtiene vía itemCategory.parentCategory.
  categoryId       String         @map("category_id") @db.Uuid
  unitOfMeasureId  String         @map("unit_of_measure_id") @db.Uuid
  brand            String?        @db.VarChar(50)
  /// Equipos / marcas / modelos compatibles (texto libre para cruce con flota).
  compatibilityInfo String?     @map("compatibility_info") @db.Text
  /// Proveedor habitual del artículo (distinto al proveedor de OC en módulo de compras).
  supplierId        String?      @map("supplier_id") @db.Uuid

  isSerialized    Boolean       @default(false) @map("is_serialized")
  isInventory     Boolean       @default(true)  @map("is_inventory")
  isAsset         Boolean       @default(false) @map("is_asset")
  isConsumable    Boolean       @default(true)  @map("is_consumable")

  /// Bodega en la que, al primer movimiento que cree `item_stocks`, se aplicarán policyMinStock / policyMaxStock (sin fila hasta entonces).
  policyTargetWarehouseId String?   @map("policy_target_warehouse_id") @db.Uuid
  policyMinStock          Float?    @map("policy_min_stock")
  policyMaxStock          Float?    @map("policy_max_stock")

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemCategory      ItemCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventorySupplier InventorySupplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  unitOfMeasure     UnitOfMeasure  @relation(fields: [unitOfMeasureId], references: [id], onDelete: Restrict)
  policyTargetWarehouse Warehouse? @relation("InventoryItemPolicyTargetWarehouse", fields: [policyTargetWarehouseId], references: [id], onDelete: SetNull)
  stocks            ItemStock[]
  transactions      InventoryTransaction[]
  workOrderParts             WorkOrderPart[]
  workOrderFluidCompartments WorkOrderFluidCompartment[]
  stockReservations StockReservation[]
  requisitionItems  RequisitionItem[]
  purchaseOrderItems PurchaseOrderItem[]
  attachments        InventoryItemAttachment[]
  inventoryTransferLines InventoryTransferLine[]

  @@unique([tenantId, partNumber])
  @@unique([tenantId, qrCode])
  @@unique([tenantId, inventoryCode])
  @@index([tenantId, qrCode])
  @@index([tenantId, inventoryCode])
  @@map("inventory_items")
}

/// PDFs / fichas técnicas adjuntas al artículo (almacenamiento vía StorageService).
model InventoryItemAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  fileName     String   @map("file_name") @db.VarChar(255)
  /// Clave relativa devuelta por el driver (ej. `inventory-item-docs/123-file.pdf`).
  storageKey   String   @map("storage_key") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(120)
  sizeBytes    Int?     @map("size_bytes")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([tenantId, itemId])
  @@map("inventory_item_attachments")
}

model ItemStock {
  id              String        @id @default(uuid()) @db.Uuid
  warehouseId     String        @map("warehouse_id") @db.Uuid
  itemId          String        @map("item_id") @db.Uuid
  binId           String?       @map("bin_id") @db.Uuid
  
  quantity        Float         @default(0) 
  unitCost        Decimal?      @map("unit_cost") @db.Decimal(18, 4)
  minStock        Float         @default(0) @map("min_stock")
  maxStock        Float         @default(0) @map("max_stock")
  /// Ubicación física en esta bodega (pasillo/estante; independiente por bodega).
  location        String?       @map("location") @db.VarChar(120)

  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  bin             WarehouseBin? @relation(fields: [binId], references: [id], onDelete: SetNull)

  @@unique([warehouseId, itemId]) 
  @@map("item_stocks")
}

model InventoryTransaction {
  id              String          @id @default(uuid()) @db.Uuid
  warehouseId     String          @map("warehouse_id") @db.Uuid
  itemId          String          @map("item_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid 
  
  type            TransactionType
  quantity        Float           
  previousStock   Float           @map("previous_stock") 
  newStock        Float           @map("new_stock")      
  
  referenceId     String?         @map("reference_id") @db.Uuid 
  referenceType   String?         @map("reference_type") @db.VarChar(50) 
  notes           String?         @db.Text
  isPendingRegularization Boolean @default(false) @map("is_pending_regularization")
  
  date            DateTime        @default(now())

  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  item            InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Listados/kardex por bodega y rango temporal (tenant vía warehouse).
  @@index([warehouseId, date])
  @@index([date])
  /// Filtros por tipo de movimiento (rol análogo a «estado» en otras tablas).
  @@index([type, date])
  @@map("inventory_transactions")
}

enum TransactionType {
  IN      
  OUT     
  ADJUST  
  RETURN
  /** Devolución a bodega de material despachado a una OT (trazabilidad explícita). */
  WORK_ORDER_RETURN
  PURCHASE_RECEIPT
  WORK_ORDER_ISSUE
  TRANSFER_OUT
  TRANSFER_IN
}

enum InventoryTransferStatus {
  SHIPPED
  COMPLETED
  CANCELLED
}

/// Transferencia entre bodegas (W2W); líneas y transacciones en una sola operación atómica.
model InventoryTransfer {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @map("tenant_id") @db.Uuid
  originWarehouseId      String                  @map("origin_warehouse_id") @db.Uuid
  destinationWarehouseId String                  @map("destination_warehouse_id") @db.Uuid
  status                 InventoryTransferStatus @default(SHIPPED)
  createdById            String                  @map("created_by_id") @db.Uuid
  createdAt              DateTime                @default(now()) @map("created_at")

  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  originWarehouse        Warehouse     @relation("InventoryTransferOrigin", fields: [originWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse     @relation("InventoryTransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  createdBy              User          @relation("InventoryTransferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  lines                  InventoryTransferLine[]

  @@index([tenantId, createdAt])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id         String   @id @default(uuid()) @db.Uuid
  transferId String   @map("transfer_id") @db.Uuid
  itemId     String   @map("item_id") @db.Uuid
  quantity   Float
  unitCost   Decimal  @map("unit_cost") @db.Decimal(18, 4)

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("inventory_transfer_lines")
}

// ==========================================
// 9. AJUSTES DE MEDIDOR (HORÓMETRO/ODÓMETRO)
// ==========================================
model MeterAdjustment {
  id            String    @id @default(uuid()) @db.Uuid
  equipmentId   String    @map("equipment_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  oldValue      Int       @map("old_value")
  newValue      Int       @map("new_value")
  date          DateTime  @default(now())
  reason        String?   @db.Text

  equipment     Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("meter_adjustments")
}

enum MeterLogSource {
  OT
  MANUAL
  TELEMETRY
}

model EquipmentMeterLog {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  equipmentId  String          @map("equipment_id") @db.Uuid
  oldValue     Decimal         @map("old_value") @db.Decimal(14, 4)
  newValue     Decimal         @map("new_value") @db.Decimal(14, 4)
  source       MeterLogSource
  sourceId     String?         @map("source_id") @db.VarChar(80)
  date         DateTime        @default(now()) @map("date")
  userId       String          @map("user_id") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, equipmentId, date])
  @@map("equipment_meter_logs")
}

/// Costos imputados al activo desde compras (PURCHASE) u órdenes de trabajo (WORK_ORDER).
model AssetCostRecord {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  equipmentId        String            @map("equipment_id") @db.Uuid
  amount             Decimal           @db.Decimal(18, 2)
  type               AssetCostType
  purchaseOrderId    String?           @map("purchase_order_id") @db.Uuid
  workOrderId        String?           @map("work_order_id") @db.Uuid
  warehouseReceiptId String?           @unique @map("warehouse_receipt_id") @db.Uuid
  recordedAt         DateTime          @default(now()) @map("recorded_at")

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  equipment          Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  purchaseOrder      PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  workOrder          WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  warehouseReceipt   WarehouseReceipt? @relation(fields: [warehouseReceiptId], references: [id], onDelete: SetNull)

  @@index([tenantId, equipmentId])
  @@index([tenantId, recordedAt])
  @@map("asset_cost_records")
}

enum AssetCostType {
  PURCHASE
  WORK_ORDER
}

enum WarehouseType {
  PHYSICAL
  VIRTUAL
  TRANSIT
}

// ==========================================
// 10. RESERVAS DE STOCK (OTs ABIERTAS)
// ==========================================
model StockReservation {
  id            String        @id @default(uuid()) @db.Uuid
  workOrderId   String        @map("work_order_id") @db.Uuid
  itemId        String        @map("item_id") @db.Uuid
  warehouseId   String        @map("warehouse_id") @db.Uuid
  quantity      Float
  createdAt     DateTime      @default(now()) @map("created_at")

  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, itemId, warehouseId])
  @@map("stock_reservations")
}

// ==========================================
// 11. CONTADOR DE SECUENCIAS (CORRELATIVOS)
// ==========================================
model SequenceCounter {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(10)
  prefix        String   @db.VarChar(10)
  lastNumber    Int      @default(0) @map("last_number")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType])
  @@map("sequence_counters")
}

// ==========================================
// 12. MAESTRO DE PROVEEDORES
// ==========================================
model Vendor {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String    @db.VarChar(50)
  name          String    @db.VarChar(200)
  rut           String?   @db.VarChar(20)
  contactName   String?   @map("contact_name") @db.VarChar(100)
  contactEmail  String?   @map("contact_email") @db.VarChar(100)
  contactPhone  String?   @map("contact_phone") @db.VarChar(20)
  address       String?   @db.VarChar(255)
  isActive      Boolean   @default(true) @map("is_active")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotations       PurchaseQuotation[]
  purchaseInvoices PurchaseInvoice[]

  @@unique([tenantId, code])
  @@unique([tenantId, rut])
  @@map("vendors")
}

// ==========================================
// 13. CONFIGURACIÓN DINÁMICA DE COMPRAS
// ==========================================
model PurchaseSettings {
  id                           String   @id @default(uuid()) @db.Uuid
  tenantId                     String   @unique @map("tenant_id") @db.Uuid
  approvalThreshold            Decimal  @default(0) @map("approval_threshold") @db.Decimal(18, 2)
  currency                     String   @default("CLP") @db.VarChar(10)
  /// Margen relativo (p. ej. 1 = 1%) para el match factura vs OC / recepción (3-way match).
  invoiceMatchTolerancePercent Decimal  @default(1) @map("invoice_match_tolerance_percent") @db.Decimal(9, 4)

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvalPolicies   ApprovalPolicy[]

  @@map("purchase_settings")
}

model ApprovalPolicy {
  id                  String           @id @default(uuid()) @db.Uuid
  purchaseSettingsId  String           @map("purchase_settings_id") @db.Uuid
  tenantId            String           @map("tenant_id") @db.Uuid
  level               Int
  description         String?          @db.VarChar(100)
  minAmount           Decimal          @default(0) @db.Decimal(18, 2) @map("min_amount")

  purchaseSettings    PurchaseSettings @relation(fields: [purchaseSettingsId], references: [id], onDelete: Cascade)
  allowedUsers        ApprovalPolicyUser[]
  approvals           PurchaseOrderApproval[]

  @@unique([tenantId, level])
  @@map("approval_policies")
}

/// Usuarios autorizados para firmar en un nivel de aprobación específico.
/// Reemplaza el enfoque anterior basado en TenantRole.
model ApprovalPolicyUser {
  id        String         @id @default(uuid()) @db.Uuid
  policyId  String         @map("policy_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  /// Desnormalizado para queries multi-tenant seguras sin JOIN adicional.
  tenantId  String         @map("tenant_id") @db.Uuid

  policy    ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user      User           @relation("ApprovalPolicyUsers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([policyId, userId])
  @@index([tenantId, userId])
  @@map("approval_policy_users")
}

// ==========================================
// 14. MÓDULO DE COMPRAS (P2P)
// ==========================================

// -- Requerimientos de Compra --
model PurchaseRequisition {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  contractId      String              @map("contract_id") @db.Uuid
  subcontractId   String?             @map("subcontract_id") @db.Uuid
  correlative     String              @db.VarChar(30)
  requestedById   String              @map("requested_by_id") @db.Uuid
  status          RequisitionStatus   @default(DRAFT)
  description     String              @db.Text
  justification   String?             @db.Text
  equipmentId     String?             @map("equipment_id") @db.Uuid
  workOrderId     String?             @map("work_order_id") @db.Uuid
  priority        RequisitionPriority @default(MEDIUM)

  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract        Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  subcontract     Subcontract?        @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  requestedBy     User                @relation("RequisitionRequester", fields: [requestedById], references: [id])
  equipment       Equipment?          @relation("RequisitionEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  workOrder       WorkOrder?          @relation("RequisitionWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  items           RequisitionItem[]
  quotations      PurchaseQuotation[]
  purchaseOrders  PurchaseOrder[]

  @@unique([tenantId, correlative])
  @@index([tenantId, equipmentId])
  @@index([tenantId, workOrderId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("purchase_requisitions")
}

model RequisitionItem {
  id              String              @id @default(uuid()) @db.Uuid
  requisitionId   String              @map("requisition_id") @db.Uuid
  inventoryItemId String?             @map("inventory_item_id") @db.Uuid
  description     String              @db.VarChar(255)
  /// Nº de parte libre (opcional; refina la solicitud aunque no exista en inventario)
  partNumber      String?             @map("part_number") @db.VarChar(80)
  /// Notas / especificación opcional (marca deseada, alternativos, etc.)
  itemNotes       String?             @map("item_notes") @db.VarChar(500)
  quantity        Float
  unitOfMeasure   String              @map("unit_of_measure") @db.VarChar(20)
  estimatedCost   Decimal?            @map("estimated_cost") @db.Decimal(18, 2)
  /// Línea de cotización adjudicada para compra (split multiproveedor).
  awardedQuotationItemId String?     @map("awarded_quotation_item_id") @db.Uuid

  requisition            PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  inventoryItem          InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  quotationItems         QuotationItem[]
  awardedQuotationItem   QuotationItem?      @relation("RequisitionItemAward", fields: [awardedQuotationItemId], references: [id], onDelete: SetNull)

  @@map("requisition_items")
}

// -- Cotizaciones --
model PurchaseQuotation {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  requisitionId   String              @map("requisition_id") @db.Uuid
  vendorId        String              @map("vendor_id") @db.Uuid
  totalAmount     Decimal             @map("total_amount") @db.Decimal(18, 2)
  currency        String              @default("CLP") @db.VarChar(10)
  deliveryDays    Int?                @map("delivery_days")
  validUntil      DateTime?           @map("valid_until")
  attachmentUrl   String?             @map("attachment_url") @db.VarChar(500)
  status          QuotationStatus     @default(RECEIVED)
  isWinner        Boolean             @default(false) @map("is_winner")

  createdAt       DateTime            @default(now()) @map("created_at")

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requisition     PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  vendor          Vendor              @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items           QuotationItem[]
  purchaseOrders  PurchaseOrder[]

  @@map("purchase_quotations")
}

model QuotationItem {
  id                String            @id @default(uuid()) @db.Uuid
  quotationId       String            @map("quotation_id") @db.Uuid
  requisitionItemId String            @map("requisition_item_id") @db.Uuid
  unitPrice         Decimal           @map("unit_price") @db.Decimal(18, 2)
  brand             String?           @db.VarChar(100)
  notes             String?           @db.VarChar(255)

  quotation                    PurchaseQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requisitionItem              RequisitionItem   @relation(fields: [requisitionItemId], references: [id], onDelete: Restrict)
  requisitionItemsWithThisAward RequisitionItem[] @relation("RequisitionItemAward")
  purchaseOrderLines           PurchaseOrderItem[]

  @@map("quotation_items")
}

// -- Órdenes de Compra --
model PurchaseOrder {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  contractId         String              @map("contract_id") @db.Uuid
  subcontractId      String?             @map("subcontract_id") @db.Uuid
  /// Trazabilidad directa 1:N requerimiento → órdenes de compra (split multiproveedor).
  requisitionId      String?             @map("requisition_id") @db.Uuid
  quotationId        String?             @map("quotation_id") @db.Uuid
  correlative        String              @db.VarChar(30)
  status             PurchaseOrderStatus @default(DRAFT)
  totalAmount        Decimal             @map("total_amount") @db.Decimal(18, 2)
  currency           String              @default("CLP") @db.VarChar(10)
  requiredSignatures Int                 @default(2) @map("required_signatures")
  notes              String?             @db.Text
  pdfUrl             String?             @map("pdf_url") @db.Text
  equipmentId        String?             @map("equipment_id") @db.Uuid
  workOrderId        String?             @map("work_order_id") @db.Uuid
  /** Momento en que la OC quedó marcada como enviada al proveedor (KPI lead time). */
  sentAt             DateTime?           @map("sent_at")
  /** Dirección de entrega acordada (puede distingirse de la dirección fiscal del proveedor). */
  deliveryAddress    String?             @map("delivery_address") @db.VarChar(500)
  /** Condición de pago declarada en la OC (ej. «30 días», «Contado»). */
  paymentTerms       String?             @map("payment_terms") @db.VarChar(120)

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract           Contract            @relation(fields: [contractId], references: [id], onDelete: Restrict)
  subcontract        Subcontract?        @relation(fields: [subcontractId], references: [id], onDelete: Restrict)
  requisition        PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  quotation          PurchaseQuotation?  @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  equipment          Equipment?          @relation("OrderEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)
  workOrder          WorkOrder?          @relation("OrderWorkOrder", fields: [workOrderId], references: [id], onDelete: SetNull)
  items              PurchaseOrderItem[]
  approvals          PurchaseOrderApproval[]
  receipts           WarehouseReceipt[]
  assetCostRecords   AssetCostRecord[]
  purchaseInvoice    PurchaseInvoice?

  @@unique([tenantId, correlative])
  @@index([tenantId, equipmentId])
  @@index([tenantId, workOrderId])
  @@index([tenantId, requisitionId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String         @id @default(uuid()) @db.Uuid
  purchaseOrderId String         @map("purchase_order_id") @db.Uuid
  inventoryItemId String?        @map("inventory_item_id") @db.Uuid
  description     String         @db.VarChar(255)
  quantity        Float
  unitCost        Decimal        @map("unit_cost") @db.Decimal(18, 2)
  /// Línea de cotización origen (idempotencia split y trazabilidad; IVA por OC en factura asociada).
  sourceQuotationItemId String?  @map("source_quotation_item_id") @db.Uuid

  purchaseOrder        PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem        InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  sourceQuotationItem  QuotationItem? @relation(fields: [sourceQuotationItemId], references: [id], onDelete: SetNull)
  receiptItems         ReceiptItem[]

  @@index([sourceQuotationItemId])
  @@map("purchase_order_items")
}

// -- Firmas de Aprobación --
model PurchaseOrderApproval {
  id              String              @id @default(uuid()) @db.Uuid
  purchaseOrderId String              @map("purchase_order_id") @db.Uuid
  policyId        String              @map("policy_id") @db.Uuid
  approvedById    String              @map("approved_by_id") @db.Uuid
  level           Int
  comment         String?             @db.Text
  signatureHash   String              @map("signature_hash") @db.VarChar(64)
  /// Estado de la OC al momento de firmar; usado para verificar el hash sin depender del estado actual.
  hashedStatus    String?             @map("hashed_status") @db.VarChar(40)
  integrityStatus SignatureIntegrity  @default(VALID) @map("integrity_status")
  approvedAt      DateTime            @default(now()) @map("approved_at")

  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  policy          ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  approvedBy      User           @relation("POApprover", fields: [approvedById], references: [id])

  @@unique([purchaseOrderId, level])
  @@map("purchase_order_approvals")
}

// -- Recepciones de Bodega --
model WarehouseReceipt {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  warehouseId     String        @map("warehouse_id") @db.Uuid
  receivedById    String        @map("received_by_id") @db.Uuid
  correlative     String        @db.VarChar(30)
  status          ReceiptStatus @default(PENDING)
  observations    String?       @db.Text
  receivedAt      DateTime?     @map("received_at")

  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  receivedBy      User          @relation("ReceiptReceiver", fields: [receivedById], references: [id])
  items           ReceiptItem[]
  assetCostRecord AssetCostRecord?

  @@unique([tenantId, correlative])
  @@map("warehouse_receipts")
}

model ReceiptItem {
  id               String            @id @default(uuid()) @db.Uuid
  receiptId        String            @map("receipt_id") @db.Uuid
  orderItemId      String            @map("order_item_id") @db.Uuid
  quantityExpected Float             @map("quantity_expected")
  quantityReceived Float             @map("quantity_received")
  observations     String?           @db.Text

  receipt          WarehouseReceipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem        PurchaseOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@map("receipt_items")
}

/// Factura de proveedor vinculada a una OC (relación 1:1). Validación 3-way match vs OC y recepciones.
model PurchaseInvoice {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  vendorId        String                @map("vendor_id") @db.Uuid
  purchaseOrderId String                @unique @map("purchase_order_id") @db.Uuid
  invoiceNumber   String                @map("invoice_number") @db.VarChar(80)
  emissionDate    DateTime              @map("emission_date")
  /** Vencimiento pactado para el calendario de pagos. */
  dueDate         DateTime?             @map("due_date")
  totalAmount     Decimal               @map("total_amount") @db.Decimal(18, 2)
  /** Monto neto afecto (registro manual; opcional). */
  netAmount       Decimal?              @map("net_amount") @db.Decimal(18, 2)
  /** IVA u otros impuestos (registro manual; opcional). */
  taxAmount       Decimal?              @map("tax_amount") @db.Decimal(18, 2)
  status          PurchaseInvoiceStatus @default(PENDING)
  pdfUrl          String?               @map("pdf_url") @db.VarChar(500)
  /** Referencia bancaria / comprobante al registrar el pago. */
  paymentReference String?              @map("payment_reference") @db.VarChar(120)
  /** Momento en que se registró el pago efectivo. */
  paidAt          DateTime?             @map("paid_at")

  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendor          Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@index([tenantId, vendorId])
  @@index([tenantId, dueDate])
  @@map("purchase_invoices")
}

/// Adjuntos unificados (REQ, OC, factura): clave en storage + metadatos (migración R2-ready).
model PurchaseDocument {
  id           String                 @id @default(uuid()) @db.Uuid
  tenantId     String                 @map("tenant_id") @db.Uuid
  entity       PurchaseDocumentEntity
  entityId     String                 @map("entity_id") @db.Uuid
  storageKey   String                 @map("storage_key") @db.VarChar(500)
  originalName String                 @map("original_name") @db.VarChar(255)
  mimeType     String                 @map("mime_type") @db.VarChar(120)
  sizeBytes    Int                    @map("size_bytes")
  uploadedById String                 @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([tenantId, entity, entityId])
  @@map("purchase_documents")
}

enum PurchaseDocumentEntity {
  REQUISITION
  PURCHASE_ORDER
  PURCHASE_INVOICE
}

// ==========================================
// ENUMS: MÓDULO DE COMPRAS
// ==========================================
enum PurchaseInvoiceStatus {
  PENDING
  MATCHED
  DISCREPANCY
  PAID
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  QUOTING
  PENDING_APPROVAL
  /// Al menos una línea ya tiene OC activa; puede faltar cobertura de otras líneas.
  PARTIALLY_PURCHASED
  APPROVED
  REJECTED
  CANCELLED
  /// Recepción y factura completas para todas las líneas adjudicadas (cierre contable del SRC).
  CLOSED
}

enum RequisitionPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuotationStatus {
  RECEIVED
  SELECTED
  /// Al menos una línea de esta cotización fue adjudicada; quedan líneas del proveedor sin compra en este SRC.
  PARTIALLY_SELECTED
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  REJECTED
  /** Documento comunicado / despacho administrativo al proveedor (sustituye el legado SENT_TO_SUPPLIER). */
  SENT
  /** Pedido formalizado al proveedor (mismo derecho de recepción que SENT). */
  ORDERED
  /** Legado (antes de SENT); no usar en flujos nuevos. */
  SENT_TO_SUPPLIER
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum ReceiptStatus {
  PENDING
  PARTIAL
  COMPLETED
}

enum SignatureIntegrity {
  VALID
  COMPROMISED
}

// ==========================================
// AUDITORÍA DE COMPRAS (ActivityLog)
// ==========================================
model ActivityLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  action      ActivityAction
  entityType  String         @map("entity_type") @db.VarChar(40)
  entityId    String         @map("entity_id") @db.VarChar(36)
  details     Json
  ipAddress   String?        @map("ip_address") @db.VarChar(64)
  userAgent   String?        @map("user_agent") @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("activity_logs")
}

// ==========================================
// NOTIFICACIONES WEB PUSH
// ==========================================
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique @db.Text
  p256dh    String   @map("p256dh") @db.VarChar(512)
  auth      String   @db.VarChar(256)
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("push_subscriptions")
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  SIGNATURE
  SYSTEM_UPDATE
  FILE_ACCESS
}
